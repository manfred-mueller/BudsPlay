<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/statusBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- ── Track 1 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnAddTrack0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvTrack0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Track 1: —"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRepeat0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="∞"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnRemoveTrack0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- ── Track 2 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnAddTrack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvTrack1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Track 2: —"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRepeat1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="∞"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnRemoveTrack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- ── Track 3 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="36dp">

                <Button
                    android:id="@+id/btnAddTrack2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvTrack2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Track 3: —"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRepeat2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="∞"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnRemoveTrack2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:textSize="20sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- ── Now Playing ───────────────────────────────────── -->
            <TextView
                android:id="@+id/tvSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#888888"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/now_playing_none"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_play"
                android:enabled="false"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="36dp" />

            <!-- ── Lautstärke ─────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/volume_label"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <SeekBar
                    android:id="@+id/volumeSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#60aaff"
                    android:thumbTint="#60aaff" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKeepAlive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keep_buds_on"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- ── Equalizer ──────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_eq_label"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginBottom="2dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/eqContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Fixe Statusleiste unten ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#1a2a4a"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/now_playing_none"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:progressTint="#60aaff"
            android:thumbTint="#60aaff"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#aaccff"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="#aaccff"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#aaccff"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/statusBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Slot 1 ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/track1_hint"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Spinner Slot 1 -->
                <Spinner
                    android:id="@+id/spinnerSlot0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <!-- Track hinzufügen -->
                <Button
                    android:id="@+id/btnAddTrack0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="4dp" />

                <!-- Aktiven Track entfernen -->
                <Button
                    android:id="@+id/btnRemoveTrack0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:enabled="false"
                    android:layout_marginEnd="4dp" />

                <!-- Abspielen -->
                <Button
                    android:id="@+id/btnPlay0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_play_short"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- ── Slot 2 ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/track2_hint"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <Spinner
                    android:id="@+id/spinnerSlot1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnAddTrack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnRemoveTrack1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_remove"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:enabled="false"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnPlay1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_play_short"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- ── Now Playing ───────────────────────────────────── -->
            <TextView
                android:id="@+id/tvSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#888888"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/now_playing_none"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_play"
                android:enabled="false"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp" />

            <!-- ── Lautstärke ─────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/volume_label"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/volumeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:progressTint="#60aaff"
                android:thumbTint="#60aaff"
                android:layout_marginBottom="16dp" />

            <!-- ── Equalizer ──────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_eq_label"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/eqContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Fixe Statusleiste unten ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#1a2a4a"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/now_playing_none"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:progressTint="#60aaff"
            android:thumbTint="#60aaff"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#aaccff"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="#aaccff"
                android:textSize="11sp" />

